# Copy to .env and fill in. Never commit .env.
NEWSROOM_ENV=dev
NEWSROOM_LOG_LEVEL=INFO
NEWSROOM_LOG_JSON=true

# Matches docker-compose.yml
NEWSROOM_DATABASE_URL=postgresql+asyncpg://newsroom:newsroom@localhost:5432/newsroom
NEWSROOM_REDIS_URL=redis://localhost:6379/0

# Embeddings (decision 0007)
NEWSROOM_EMBEDDING_MODEL=voyage-4-lite
NEWSROOM_VOYAGE_API_KEY=
# Voyage pacing (decision 0015). Values for a key without billing; per-minute 0 = no limit.
NEWSROOM_EMBED_REQUESTS_PER_MINUTE=3
NEWSROOM_EMBED_TOKENS_PER_MINUTE=9000
NEWSROOM_EMBED_BATCH_MAX_TOKENS=9000

# Chat completions (decision 0008). Routes/prices override as JSON, see app/config.py
NEWSROOM_GROQ_API_KEY=
# NEWSROOM_LLM_ROUTES={"draft":"openai/gpt-oss-20b","judge":"openai/gpt-oss-120b","classify":"openai/gpt-oss-20b","answer":"openai/gpt-oss-20b"}

# External services (optional until the task that uses them)
NEWSROOM_DEEPGRAM_API_KEY=
NEWSROOM_CARTESIA_API_KEY=
# Anchor (task 4.2). anchor_tts: cartesia | fake (silent audio, no key). Voice ids: GET https://api.cartesia.ai/voices
NEWSROOM_ANCHOR_TTS=cartesia
NEWSROOM_CARTESIA_VOICE_ID=5568a7df-e5ab-4442-9fae-2e9ba1b15ad8
NEWSROOM_TAVILY_API_KEY=
NEWSROOM_EXA_API_KEY=
NEWSROOM_FIRECRAWL_API_KEY=
NEWSROOM_LANGFUSE_PUBLIC_KEY=
NEWSROOM_LANGFUSE_SECRET_KEY=
NEWSROOM_LANGFUSE_HOST=https://cloud.langfuse.com
# Set to false to send only usage (no prompts or outputs) to Langfuse.
NEWSROOM_LANGFUSE_CAPTURE_CONTENT=true
