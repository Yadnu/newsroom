    "/archive/briefings": {
      "get": {
        "description": "Briefings, newest first, with claim verdict counts, cost and wall time.",
        "operationId": "get_briefings_archive_briefings_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BriefingSummary"
                  },
                  "title": "Response Get Briefings Archive Briefings Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Briefings",
        "tags": [
          "archive"
        ]
      }
    },
